# ─────────────────────────────────────────────────────────────────────────────
# PC kasir (aplikasi desktop Electron).
# Simpan sebagai file bernama ".env" (bukan .env.txt) di:
#   Windows : %APPDATA%\pos-minimarket\.env
#   macOS   : ~/Library/Application Support/pos-minimarket/.env
# Tutup aplikasi sepenuhnya lalu buka lagi setelah mengubah file ini.
# ─────────────────────────────────────────────────────────────────────────────

# Alamat web server POS (wajib https). Diisi = aplikasi memuat server ini dan
# kredensial database TIDAK perlu ada di PC kasir. Kosong = menjalankan server
# lokal (butuh MONGODB_URI & JWT_SECRET di bawah).
POS_APP_URL=https://pos.domainanda.com

# Kode unik per PC — masuk ke nomor struk offline (OF-K01-250926001).
# Wajib berbeda di setiap PC kasir. Kosong = dibuat acak otomatis.
POS_TERMINAL_ID=K01

# Header struk.
STORE_NAME=Nama Toko
STORE_ADDRESS=Alamat Toko
STORE_PHONE=08xxxxxxxxxx

# ── Printer ──────────────────────────────────────────────────────────────────
# "system" = printer USB, "bluetooth" = RPP02N / EP58 PLUS via BLE.
PRINTER_TYPE=system

# USB: kosong = printer USB pertama yang terdeteksi. Isi (desimal) kalau ada
# lebih dari satu perangkat USB printer.
# PRINTER_VID=
# PRINTER_PID=

# Bluetooth: default sudah cocok untuk RPP02N; ubah hanya kalau perlu.
# PRINTER_BT_NAME=RPP02N
# PRINTER_BT_CHAR=49535343-aca3-481c-91ec-d85e28a60318
# PRINTER_BT_CHUNK_SIZE=20
# PRINTER_BT_CHUNK_DELAY_MS=50
# PRINTER_BT_SCAN_TIMEOUT_MS=12000

# ── Hanya untuk mode server lokal (POS_APP_URL kosong) ──────────────────────
# MONGODB_URI=
# JWT_SECRET=
# ELECTRON_APP_PORT=4072

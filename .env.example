# ─────────────────────────────────────────────────────────────────────────────
# Server / development (Next.js). Salin ke .env.local (dev) atau .env di server.
# Untuk PC kasir (aplikasi desktop), lihat .env.kasir.example.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB. Transaksi jual/beli memakai multi-document transaction, jadi
# MongoDB harus replica set (atau Atlas).
MONGODB_URI=mongodb://localhost:27017/pos_minimarket

# Rahasia penandatangan cookie login — string acak panjang, jangan dibagikan.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=2h

# Header struk (dipakai kalau aplikasi desktop menjalankan server lokal).
STORE_NAME=Nama Toko
STORE_ADDRESS=Alamat Toko
STORE_PHONE=08xxxxxxxxxx
